# PostgreSQL connection string used by Prisma.
# - Local development: sslmode is not required (e.g. postgres://user:pass@localhost:5432/obrix).
# - Any environment other than localhost MUST include `sslmode=require` in the connection string,
#   e.g. postgres://user:pass@db.example.com:5432/obrix?sslmode=require
DATABASE_URL="postgres://user:password@localhost:5432/obrix"
